APP_NAME=Project Progress Register
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://ppr_app:replace-me@127.0.0.1:5432/project_progress_register?sslmode=disable
# Use a more privileged connection only for migrations when production roles differ.
MIGRATION_DATABASE_URL=
API_DOCS_ENABLED=true
SESSION_CSRF_KEY=replace-with-a-base64-encoded-32-byte-random-key
SESSION_TTL=12h
# Required only until the first Admin has been created; use at least 24 characters.
BOOTSTRAP_TOKEN=
# Private, non-public attachment root. Relative paths resolve from the process working directory.
ATTACHMENT_STORAGE_DIR=.local/attachments
# Defaults: 100 MiB per file and 10 files per progress update.
ATTACHMENT_MAX_FILE_BYTES=104857600
ATTACHMENT_MAX_FILES_PER_UPDATE=10
READINESS_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s
